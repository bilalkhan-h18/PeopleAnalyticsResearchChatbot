# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Models (see README "Cost" for trade-offs)
ANSWER_MODEL=claude-opus-5
UTILITY_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANSWER_EFFORT=high
UTILITY_EFFORT=low

# Optional: higher-quality local embeddings (requires sentence-transformers). Re-run ingest with --rebuild after changing.
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Optional: faster OpenAlex access for scripts/find_papers.py
# OPENALEX_EMAIL=you@example.com
